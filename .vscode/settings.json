  "peacock.remoteColor": "#832561",
  "tabRouter.rules": [
    {
      "matchField": "fileName",
      "pattern": "(ansible/roles/[^/]+/defaults)",
      "targetGroup": 1
    },
    {
      "matchField": "fileName",
      "pattern": "(ansible/roles/[^/]+/tasks)",
      "targetGroup": 2
    }
  ],
