#!/usr/bin/env bash
set -euo pipefail

# ? 「失敗してもコミット自体は成功している」ので、フックは落としてもOKな設計にする
# ? VSCodeのコミット体験を壊しにくい

# ? リベースは大量のコミットを作るため速度を落とさないようにする
# ? ポストリライト (git rebase によって呼び出される) を利用して、最後に一度エクスポートします。
rebase_apply="$(git rev-parse --git-path rebase-apply)"
rebase_merge="$(git rev-parse --git-path rebase-merge)"
if [[ -d "$rebase_apply" || -d "$rebase_merge" ]]; then
  exit 0
fi

[[ -f "${HOME}/.local/bin/export-archive" ]] && "${HOME}/.local/bin/export-archive"

pwd

mkdir -p .claude/skills && cp -rf .skills/* .claude/skills 
mkdir -p .codex/skills && cp -rf .skills/* .codex/skills 
mkdir -p .gemini/skills && cp -rf .skills/* .gemini/skills 
mkdir -p .cursor/skills && cp -rf .skills/* .cursor/skills 
