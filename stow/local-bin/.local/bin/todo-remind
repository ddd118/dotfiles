#!/usr/bin/env bash
set -euo pipefail

workspace="${1:-/workspace}"

# Run only once per container session (dotnet-watch と vue-start の両方から呼ばれても 1 回だけ出す)
sentinel="/tmp/tdx_todo_reminded"
if [ -f "$sentinel" ]; then
  exit 0
fi
touch "$sentinel" >/dev/null 2>&1 || true

todo_file="${workspace}/todo.txt"
inbox_file="${workspace}/inbox.txt"
waiting_file="${workspace}/waiting.txt"
someday_file="${workspace}/someday.txt"

if [ ! -f "$todo_file" ]; then
  exit 0
fi

today="$(date +%Y-%m-%d 2>/dev/null || echo '')"

count_open() {
  local f="$1"
  if [ ! -f "$f" ]; then
    echo 0
    return
  fi
  # count non-empty lines not starting with x (done)
  awk 'NF && $1 != "x" {c++} END {print c+0}' "$f" 2>/dev/null || echo 0
}

todo_open="$(count_open "$todo_file")"
inbox_open="$(count_open "$inbox_file")"
waiting_open="$(count_open "$waiting_file")"
someday_open="$(count_open "$someday_file")"

echo ""
echo "────────────────────────────────────────────────────────"
echo "TODO summary (todo.txt)  |  ${today}"
echo "  todo    : ${todo_open}"
echo "  inbox   : ${inbox_open}"
echo "  waiting : ${waiting_open}"
echo "  someday : ${someday_open}"
echo "────────────────────────────────────────────────────────"

# Show top tasks (overdue/today first, then priority)
max_lines=8

if [ "$todo_open" -gt 0 ]; then
  # Produce sortable lines: bucket|prio|due|task
  # bucket: 0 overdue, 1 today, 2 future due, 3 no due
  awk -v today="$today" '
    function bucket(due, today) {
      if (due == "") return 3
      if (today == "") return 2
      if (due < today) return 0
      if (due == today) return 1
      return 2
    }
    BEGIN { FS=""; }
    /^[[:space:]]*$/ { next }
    /^x[[:space:]]/ { next }
    {
      line=$0
      prio="Z"
      if (match(line, /^\([A-Z]\)[[:space:]]/, m)) prio=substr(line, 2, 1)
      due=""
      if (match(line, /due:([0-9]{4}-[0-9]{2}-[0-9]{2})/, m)) due=m[1]
      b=bucket(due, today)
      printf "%d|%s|%s|%s\n", b, prio, due, line
    }
  ' "$todo_file"   | sort -t'|' -k1,1n -k2,2 -k3,3   | head -n "$max_lines"   | awk -F'|' '
      {
        b=$1; pr=$2; due=$3; task=$4;
        prefix=" "
        if (b==0) prefix="!"; else if (b==1) prefix="*";
        if (due != "") {
          printf " %s (%s) [%s] %s\n", prefix, pr, due, task
        } else {
          printf " %s (%s) %s\n", prefix, pr, task
        }
      }
    '
else
  echo "  (no open tasks in todo.txt)"
fi

echo ""
echo "Hints:"
echo "  - VSCode: Ctrl/Cmd+Shift+X で完了トグル（todotxt-mode）"
echo "  - CLI   : todo.sh ls / todo.sh do <n> / todo.sh archive (入っていれば)"
echo "  - LLM   : prompt/todo-triage.prompt.md を入口に triage すると安全です"
echo "────────────────────────────────────────────────────────"
echo ""
