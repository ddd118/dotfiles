# Default rules shared across projects.
# Keep this file generic and safe; project-specific rules should live elsewhere.

# Allow common .NET build/test commands outside the sandbox without prompting.
prefix_rule(
    pattern = ["dotnet", ["build", "test"]],
    decision = "allow",
    justification = "Allow local build/test without approval prompts",
    match = [
        "dotnet build",
        "dotnet build MySolution.sln -c Release",
        "dotnet test",
        "dotnet test MyProject.Tests/MyProject.Tests.csproj",
    ],
)

# Allow npm build/test scripts outside the sandbox without prompting.
prefix_rule(
    pattern = ["npm", "run", ["build", "test"]],
    decision = "allow",
    justification = "Allow project build/test scripts without approval prompts",
    match = [
        "npm run build",
        "npm run build -- --mode production",
        "npm run test",
    ]
)

# Allow common pnpm package-management commands outside the sandbox without prompting.
prefix_rule(
    pattern = ["pnpm", ["install", "run"]],
    decision = "allow",
    justification = "Allow pnpm install and run commands without approval prompts",
    match = [
        "pnpm install",
        "pnpm install --frozen-lockfile",
        "pnpm run build",
        "pnpm run lint:ci",
        "pnpm run test",
    ],
)

# Allow pnpm commands scoped to a target directory.
# `-C` always takes a directory argument before the actual subcommand, so this is
# intentionally broader than the rule above.
prefix_rule(
    pattern = ["pnpm", "-C"],
    decision = "allow",
    justification = "Allow pnpm commands scoped to a working directory without approval prompts",
    match = [
        "pnpm -C web install",
        "pnpm -C web run build",
        "pnpm -C packages/ui run test",
    ],
)

# Allow common read-only CLI commands used for repository exploration.
prefix_rule(
    pattern = ["rg"],
    decision = "allow",
    justification = "Allow ripgrep searches without approval prompts",
    match = [
        "rg foo",
        "rg -n \"prefix_rule\" stow",
        "rg --files",
        "rg -l TODO .",
    ],
)

prefix_rule(
    pattern = ["fd"],
    decision = "allow",
    justification = "Allow file discovery with fd without approval prompts",
    match = [
        "fd",
        "fd default.rules",
        "fd -t f package.json .",
    ],
)

prefix_rule(
    pattern = ["find", "."],
    decision = "allow",
    justification = "Allow safe file discovery from the current directory without approval prompts",
    match = [
        "find . -type f",
        "find . -maxdepth 2 -type d",
        "find . -name '*.rules'",
    ],
)

prefix_rule(
    pattern = ["ls"],
    decision = "allow",
    justification = "Allow directory listing without approval prompts",
    match = [
        "ls",
        "ls -la",
        "ls stow",
    ],
)

prefix_rule(
    pattern = ["cat"],
    decision = "allow",
    justification = "Allow file reads without approval prompts",
    match = [
        "cat README.md",
        "cat stow/codex-rules/.codex/rules/default.rules",
    ],
)

prefix_rule(
    pattern = ["sed", "-n"],
    decision = "allow",
    justification = "Allow non-mutating sed reads without approval prompts",
    match = [
        "sed -n '1,120p' README.md",
        "sed -n '1,200p' stow/codex-rules/.codex/rules/default.rules",
    ],
)

prefix_rule(
    pattern = ["git", ["status", "diff", "show", "ls-files"]],
    decision = "allow",
    justification = "Allow read-only git inspection without approval prompts",
    match = [
        "git status --short",
        "git diff -- stow/codex-rules/.codex/rules/default.rules",
        "git show HEAD~1",
        "git ls-files",
    ],
)

prefix_rule(
    pattern = ["git", "-C"],
    decision = "allow",
    justification = "Allow read-only git inspection scoped to a repository path without approval prompts",
    match = [
        "git -C /workspace status --short",
        "git -C /workspace diff -- src/app.ts",
        "git -C /workspace ls-files",
    ],
)
prefix_rule(pattern=["docker", "build"], decision="allow")
prefix_rule(pattern=["curl"], decision="allow")
prefix_rule(pattern=["pnpm", "--dir", "web", "build"], decision="allow")
