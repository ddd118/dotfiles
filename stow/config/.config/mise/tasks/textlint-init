#!/usr/bin/env bash
set -euo pipefail

TEMPLATE_ROOT="${HOME}/.config/textlint/templates"

if [ ! -f package.json ]; then
  cat > package.json <<EOF
{
  "name": "$(basename "$PWD")",
  "private": true
}
EOF
fi

pnpm add -D \
  textlint \
  textlint-rule-preset-japanese \
  textlint-rule-prh \
  textlint-filter-rule-comments \
  textlint-filter-rule-allowlist

copy_if_missing() {
  local src="$1"
  local dst="$2"
  if [ -e "$dst" ]; then
    echo "skip: $dst"
  else
    cp "$src" "$dst"
    echo "create: $dst"
  fi
}

copy_if_missing "${TEMPLATE_ROOT}/.textlintrc.json" ./.textlintrc.json
copy_if_missing "${TEMPLATE_ROOT}/.textlintignore" ./.textlintignore
copy_if_missing "${TEMPLATE_ROOT}/prh.yml" ./prh.yml
copy_if_missing "${TEMPLATE_ROOT}/textlint-allowlist.json" ./textlint-allowlist.json
